<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Tier-B (local in-process controller) tests. ISOLATED + opt-in on purpose:
      referencing OutWit.Controller.Render triggers the controller's asset resolver,
      which fetches per-platform Blender/FFmpeg (~GBs) into the output. Keeping this in a
      separate project means the default CI build of OutWit.Render.BlenderBridge.Tests
      (pure-local + Tier-A [Explicit]) stays lean and never pulls those assets.

      These tests run the REAL render controller in-process via the public OutWit.Engine.Sdk
      (no WitCloud server, no online clients, no deploy cycle). They Assert.Ignore when no
      host Blender runtime is available. See ../OutWit.Render.BlenderBridge.Tests/TIER_B_LOCAL_CONTROLLER_PLAN.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
  </ItemGroup>

  <!-- Reuse the bridge REST host harness (BridgeLocalHost, BridgeRestTestUtils) from the main
       test project via InternalsVisibleTo, so Tier-B drives the full bridge stack exactly like
       the live tier — same bodies, different (local-engine) cloud connection service. -->
  <ItemGroup>
    <ProjectReference Include="..\OutWit.Render.BlenderBridge.Tests\OutWit.Render.BlenderBridge.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OutWit.Engine.Sdk" Version="1.1.*" />
    <PackageReference Include="OutWit.Controller.Render" Version="1.16.0" />
    <PackageReference Include="OutWit.Controller.Render.Scripts" Version="1.0.1" />
    <PackageReference Include="OutWit.Controller.Render.Model" Version="1.3.0" />
    <!-- Render declares runtime [WitPluginDependency] on the Variables + Grid controllers, so their
         modules must be staged next to render.module for the engine's plugin loader to resolve them. -->
    <PackageReference Include="OutWit.Controller.Variables" Version="1.0.*" />
    <PackageReference Include="OutWit.Controller.Grid" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
