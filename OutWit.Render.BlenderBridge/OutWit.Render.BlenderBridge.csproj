<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The OmnibusCloud tray mark, so the bridge is recognizable in Task Manager / Explorer.
         The default 1.0.0 is overridden by CI (-p:Version from the addon tag) so the bridge
         reports the addon release it shipped with. -->
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.16.0" />
    <PackageReference Include="OutWit.Common" Version="1.3.2" />
    <PackageReference Include="OutWit.Common.DependencyInjection" Version="1.1.*" />
    <PackageReference Include="OutWit.Common.MemoryPack" Version="1.1.4" />
    <!-- Per-OS-user render preferences (the "remember last render settings" buckets). The OIDC token
         is NOT stored here — it stays in its own DPAPI-encrypted file (BridgeSessionStore). -->
    <PackageReference Include="OutWit.Common.Settings" Version="2.0.2" />
    <PackageReference Include="OutWit.Common.Settings.Json" Version="2.1.1" />
    <PackageReference Include="OutWit.Communication.Client" Version="2.3.3" />
    <PackageReference Include="OutWit.Communication.Client.WebSocket" Version="2.3.3" />
    <PackageReference Include="OutWit.Communication.Server.DependencyInjection" Version="2.3.9" />
    <PackageReference Include="OutWit.Communication.Server.Rest" Version="2.3.4" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public, recommended way to attach to WitCloud / OmnibusCloud.
         OutWit.Cloud.SDK brings OutWit.Cloud.Contracts (IApiChannel/IBlobChannel
         + DTOs) transitively. -->
    <PackageReference Include="OutWit.Cloud.SDK" Version="1.1.*" />
    <PackageReference Include="OutWit.Controller.Render.Model" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Immutable render-preference defaults are EMBEDDED (logical name "render-settings.json") and
         read via UseJsonResource — baked into the binary, not a loose file (same rationale as the
         worker client: keeps per-platform bundles signable). The per-user writable store is a JSON
         file next to the bridge session (%appdata%/OmnibusCloud/Bridge/). -->
    <EmbeddedResource Include="Resources\render-settings.json">
      <LogicalName>render-settings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
